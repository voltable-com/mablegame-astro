---
import '@/styles/reset.css'
import '@/styles/main.css'

import { SEO } from "astro-seo"
import { seoconfig } from "@/utils/seoconfig"
import Favicons from "@/components/Favicons.astro"
import Fonts from "@/components/Fonts.astro"
import CookieConsent from "@/components/CookieConsent.astro"
import CookieConsentStyle from "@/components/CookieConsentStyle.astro"

// Props
export interface Props {
	title: string
	ogTitle?: string
	description?: string
	image?: {
		url: string
		alt: string
	}
}
const {
	title,
	ogTitle,
	description,
	image
} = Astro.props as Props
---
<!DOCTYPE html>
<html lang="en" class="theme-light">
<head>

    <!-- Global meta tags. -->
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="author" content="Voltable.com, @VoltableCom">
    <meta name="keywords" content="voltable, online game, web game, mable game">
    <link rel="manifest" href="manifest.webmanifest">

    <script src="/js/game.js" is:inline></script>
    <script defer src="/js/alpine.js" is:inline></script>

    <SEO
        title={title}
        canonical={seoconfig.baseURL}
        description={seoconfig.description || description}
        openGraph={{
            basic: {
                title: ogTitle || title,
                type: "website",
                image: seoconfig.image.url || image.url
            },
            image: {
                width: seoconfig.image.width,
                height: seoconfig.image.height,
                alt: seoconfig.image.alt || image.alt
            },
            optional: {
                siteName: seoconfig.siteName,
                description: seoconfig.description || description
            }
        }}
        twitter={{
            ccard: seoconfig.twitter.card,
            site: seoconfig.twitter.site,
            title: ogTitle || title,
            description: seoconfig.description || description,
            image: seoconfig.twitter.image,
            imageAlt: seoconfig.twitter.imageAlt,
            creator: seoconfig.twitter.creator
        }}
    />

    <Fonts />
    <Favicons />
    <CookieConsentStyle />

</head>
<body>

    <div class="a">
        <slot />
    </div>

    <CookieConsent />

</body>
</html>
