---
import '@/styles/reset.css'
import '@/styles/main.css'

import { SEO } from "astro-seo"
import { seoconfig } from "@/utils/seoconfig"
import Favicons from "@/components/Favicons.astro"
import Fonts from "@/components/Fonts.astro"
import CookieConsent from "@/components/CookieConsent.astro"
import CookieConsentStyle from "@/components/CookieConsentStyle.astro"

// Props
export interface Props {
	title: string
	ogTitle?: string
	description?: string
	image?: {
		url: string
		alt: string
	}
}
const {
	title,
	ogTitle,
	description = seoconfig.description,
	image = seoconfig.image
} = Astro.props as Props

const base = import.meta.env.BASE_URL
---
<!DOCTYPE html>
<html lang="en" class="theme-light">
<head>

    <!-- Global meta tags. -->
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="author" content="Voltable.com, @VoltableCom">
    <meta name="keywords" content="voltable, online game, web game, mable game">
    <link rel="manifest" href={`${base}manifest.webmanifest`}>
    {import.meta.env.PROD && (
        <script is:inline define:vars={{ base }}>
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', () => navigator.serviceWorker.register(`${base}sw.js`));
            }
        </script>
    )}

    <!-- Apply the saved (or system) theme before first paint. -->
    <script is:inline>
        (() => {
            let theme = null;
            try {
                theme = localStorage.getItem('theme');
            } catch (e) {}
            if (theme !== 'theme-light' && theme !== 'theme-dark') {
                theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'theme-dark' : 'theme-light';
            }
            document.documentElement.className = theme;
        })();
    </script>

    <script src={`${base}js/game.js`} is:inline></script>
    <script defer src={`${base}js/alpine.js`} is:inline></script>

    <SEO
        title={title}
        canonical={seoconfig.baseURL}
        description={description}
        openGraph={{
            basic: {
                title: ogTitle || title,
                type: "website",
                image: image.url
            },
            image: {
                width: seoconfig.image.width,
                height: seoconfig.image.height,
                alt: image.alt
            },
            optional: {
                siteName: seoconfig.siteName,
                description: description
            }
        }}
        twitter={{
            card: seoconfig.twitter.card,
            site: seoconfig.twitter.site,
            title: ogTitle || title,
            description: description,
            image: seoconfig.twitter.image,
            imageAlt: seoconfig.twitter.imageAlt,
            creator: seoconfig.twitter.creator
        }}
    />

    <Fonts />
    <Favicons />
    <CookieConsentStyle />

</head>
<body>

    <a class="skip-link" href="#play">Skip to the game</a>

    <slot />

    <CookieConsent />

</body>
</html>

<style>
.skip-link {
    position: absolute;
    top: -3rem;
    left: 1rem;
    z-index: 100;
    padding: .6rem 1rem;
    border-radius: 999px;
    background: var(--sun);
    color: #231d36;
    font-weight: 800;
    text-decoration: none;
    transition: top .2s ease;
}
.skip-link:focus {
    top: 1rem;
}
</style>
