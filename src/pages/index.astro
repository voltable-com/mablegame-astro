---
import ToggleTheme from '@component/ToggleTheme.astro'
import Footer from '@component/Footer.astro'
import EtoroBanner from '@component/EtoroBanner.astro'
import HowToPlay from '@component/HowToPlay.astro'
import AboutGame from '@component/AboutGame.astro'
import GameHeader from '@component/GameHeader.astro'
import Game from '@component/Game.astro'
import Layout from '@layout/Layout.astro'

const title = "Mable game by Voltable.com - guess the multiplication"
---
