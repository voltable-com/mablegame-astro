---
import NavBar from '@/components/NavBar.astro'
import Footer from '@/components/Footer.astro'
import Features from '@/components/Features.astro'
import HowToPlay from '@/components/HowToPlay.astro'
import Tips from '@/components/Tips.astro'
import AboutGame from '@/components/AboutGame.astro'
import ShareCta from '@/components/ShareCta.astro'
import GameHeader from '@/components/GameHeader.astro'
import Game from '@/components/Game.astro'
import Layout from '@/layouts/Layout.astro'

const title = "Mable game by Voltable.com - guess the multiplication"
---
<Layout title={title}>
  <NavBar />
  <main>
    <div class="hero container">
      <GameHeader />
      <Game />
    </div>
    <Features />
    <HowToPlay />
    <Tips />
    <AboutGame />
    <ShareCta />
  </main>
  <Footer />
</Layout>

<style>
.hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: clamp(2rem, 5vw, 4.5rem);
  align-items: start;
  padding-top: clamp(1rem, 4vw, 3rem);
}
@media (max-width: 980px) {
  .hero {
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
  }
}
</style>
