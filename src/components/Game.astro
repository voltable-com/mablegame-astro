---
import SocialShare from '@/components/SocialShare.astro';
---

<section id="play" class="game" x-data="mable()" aria-labelledby="play-title">

    <div class="board-card card">
        <header class="board-head">
            <div>
                <p class="board-kicker">Your puzzle</p>
                <h2 id="play-title">Find <span class="factors">A &times; B</span></h2>
            </div>
            <a class="btn btn-secondary btn-sm" href="/">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15.5 6.2L3 16"/><path d="M3 21v-5h5"/></svg>
                New puzzle
            </a>
        </header>

        <div class="progress">
            <div class="progress-track" role="progressbar" aria-label="Hidden digits filled" aria-valuemin="0" :aria-valuemax="total" :aria-valuenow="found">
                <div class="progress-bar" :style="`width: ${progress}%`"></div>
            </div>
            <p class="progress-label" aria-live="polite">
                <span x-show="!ready">Shuffling the digits&hellip;</span>
                <span x-show="ready" x-cloak><strong x-text="found"></strong> of <strong x-text="total"></strong> hidden digits filled</span>
            </p>
        </div>

        <div x-ref="result" class="result" :class="{ 'result-win': ended, 'result-lose': wrong }" x-show="ended || wrong" x-cloak x-transition.opacity.duration.400ms>
            <img class="result-face" src="/favicon.svg" alt="" width="72" height="72" />
            <div x-show="ended">
                <h3>Congratulations!</h3>
                <p>You guessed the multiplication! You are right, the correct numbers are: <code x-html="solution"></code></p>
            </div>
            <div x-show="wrong">
                <h3>So close!</h3>
                <p>Hmm! You finished the game but have not found the numbers. The correct numbers are: <code x-html="solution"></code></p>
            </div>
            <a class="btn btn-primary" href="/">Click to start again!</a>
            <p class="result-share" x-text="ended ? 'Pass the challenge to friends:' : 'Could your friends guess the multiplication?'"></p>
            <div class="share-row">
                <SocialShare />
            </div>
        </div>

        <div class="board-wrap">
            <div class="b" id="b" @click="aclick" :class="{ 'is-ready': ready }">
                <template x-for="row in 19" x-cloak>
                    <template x-for="col in 10" x-cloak>
                        <div></div>
                    </template>
                </template>
            </div>
        </div>

        <ul class="legend" aria-label="Board legend">
            <li><span class="swatch swatch-given">7</span> Given digit</li>
            <li><span class="swatch swatch-hidden">x</span> Hidden, click to guess</li>
            <li><span class="swatch swatch-guess">3</span> Your guess</li>
        </ul>
    </div>

    <div class="confetti" x-show="ended" x-cloak aria-hidden="true">
        <template x-for="i in 36">
            <i :style="`--i: ${i}`"></i>
        </template>
    </div>
</section>

<style>
.game {
    position: relative;
}
.board-card {
    padding: clamp(.75rem, 3vw, 1.75rem);
    box-shadow: var(--shadow-lg);
}
.board-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
}
.board-kicker {
    color: var(--muted);
    font-size: .8rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
}
.board-head h2 {
    font-size: clamp(1.5rem, 3vw, 1.9rem);
}
.factors {
    font-family: var(--mono);
    font-weight: 800;
    color: var(--pink-ink);
}
.progress {
    margin-bottom: 1.25rem;
}
.progress-track {
    height: .7rem;
    border-radius: var(--radius-pill);
    background: var(--cell-hidden-bg);
    overflow: hidden;
}
.progress-bar {
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--mint), var(--sky), var(--grape), var(--pink));
    background-size: 300% 100%;
    transition: width .5s var(--ease-out);
    animation: shimmer 6s linear infinite alternate;
}
.progress-label {
    margin-top: .45rem;
    color: var(--muted);
    font-size: .9rem;
}
.progress-label strong {
    color: var(--text);
    font-family: var(--mono);
}
.board-wrap {
    padding: clamp(.4rem, 2vw, 1.1rem);
    border-radius: var(--radius);
    background: var(--surface-solid);
    border: 1px solid var(--border);
}
.legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .5rem 1.25rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: .88rem;
}
.legend li {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
}
.swatch {
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 7px;
    font-family: var(--mono);
    font-weight: 700;
    font-size: .85rem;
}
.swatch-given {
    background: var(--cell-given-bg);
    color: var(--cell-given-fg);
    box-shadow: 0 2px 0 var(--cell-given-edge);
}
.swatch-hidden {
    background: var(--cell-hidden-bg);
    color: var(--cell-hidden-fg);
    box-shadow: inset 0 0 0 1.5px var(--cell-hidden-ring);
}
.swatch-guess {
    background: var(--cell-guess-bg);
    color: var(--cell-guess-fg);
    box-shadow: inset 0 0 0 1.5px var(--cell-guess-ring);
}
.result {
    contain: inline-size;
    display: grid;
    justify-items: center;
    gap: .75rem;
    margin-bottom: 1.25rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    text-align: center;
}
.result-win {
    background: linear-gradient(135deg, rgb(255 204 0 / .3), rgb(255 79 163 / .22), rgb(124 77 255 / .22));
    border: 2px solid rgb(255 204 0 / .7);
}
.result-lose {
    background: linear-gradient(135deg, rgb(34 166 242 / .18), rgb(124 77 255 / .2));
    border: 2px solid rgb(124 77 255 / .45);
}
.result h3 {
    font-size: 1.75rem;
    margin-bottom: .25rem;
}
.result code {
    font-size: 1.1em;
    white-space: nowrap;
}
.result-face {
    width: 72px;
    height: 72px;
    animation: wiggle 1.2s ease-in-out infinite;
}
.result-share {
    margin-top: .25rem;
    color: var(--muted);
    font-weight: 700;
}
.share-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .6rem;
}
.confetti {
    position: fixed;
    inset: 0;
    z-index: 50;
    overflow: hidden;
    pointer-events: none;
}
.confetti i {
    position: absolute;
    top: -2rem;
    left: calc(var(--i) * 2.75% - 1%);
    width: .65rem;
    height: 1rem;
    border-radius: 3px;
    background: var(--sun);
    animation: confetti-fall 4.2s cubic-bezier(.3, .6, .5, 1) both;
    animation-delay: calc(mod(var(--i) * 137, 1500) * 1ms);
}
.confetti i:nth-child(5n+1 of i) { background: var(--pink); width: .5rem; }
.confetti i:nth-child(5n+2 of i) { background: var(--grape); border-radius: 50%; height: .65rem; }
.confetti i:nth-child(5n+3 of i) { background: var(--sky); }
.confetti i:nth-child(5n+4 of i) { background: var(--mint); height: .6rem; }
.confetti i:nth-child(3n of i) { animation-duration: 3.4s; }
.confetti i:nth-child(4n of i) { animation-duration: 5s; }
@keyframes confetti-fall {
    0% { transform: translate3d(0, 0, 0) rotate(0deg); opacity: 1; }
    100% { transform: translate3d(calc((mod(var(--i), 7) - 3) * 2rem), 110vh, 0) rotate(calc(var(--i) * 97deg)); opacity: .9; }
}
@media (prefers-reduced-motion: reduce) {
    .confetti {
        display: none;
    }
}
</style>
