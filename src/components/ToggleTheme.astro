---
---
<div class="theme-switch-wrapper" x-data="toggletheme()">
    <button type="button" class="theme-switch" :class="{ 'is-dark': dark }" @click="switchTheme" :aria-pressed="dark.toString()" aria-pressed="false" title="Enable/Disable Dark Mode!">
        <span class="visually-hidden">Dark mode</span>
        <svg class="icon sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2" fill="currentColor" stroke="none" />
            <path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
        </svg>
        <svg class="icon moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a.6.6 0 0 0-.8-.7A9.5 9.5 0 1 0 21.2 15.4a.6.6 0 0 0-.7-.8Z" />
        </svg>
    </button>
</div>
<style>
.theme-switch {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface-solid);
    color: var(--sun-deep);
    cursor: pointer;
    box-shadow: 0 3px 0 var(--border);
    transition: transform .25s var(--ease-bounce), background-color .3s ease, color .3s ease;
}
.theme-switch:hover {
    transform: translateY(-2px) rotate(-8deg);
}
.theme-switch:active {
    transform: translateY(1px);
}
.icon {
    grid-area: 1 / 1;
    width: 1.35rem;
    height: 1.35rem;
    transition: transform .45s var(--ease-bounce), opacity .25s ease;
}
.moon {
    opacity: 0;
    transform: rotate(-90deg) scale(.4);
}
.is-dark {
    color: #c9b8ff;
}
.is-dark .sun {
    opacity: 0;
    transform: rotate(90deg) scale(.4);
}
.is-dark .moon {
    opacity: 1;
    transform: none;
}
</style>
