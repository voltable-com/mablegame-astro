---
export interface Props {
    partytown?:boolean;
}

const {
    partytown = false
} = Astro.props as Props;

const attrs = partytown ? { type: "text/partytown" } : {};

---

<script src="https://cdn.jsdelivr.net/npm/cookieconsent@3/build/cookieconsent.min.js" data-cfasync="false" {...attrs}></script>

<script is:inline {...attrs}>
window.cookieconsent.initialise({
  "palette": {
    "popup": {
      "background": "#231d36",
      "text": "#f4f1ff"
    },
    "button": {
      "background": "#ffcc00",
      "text": "#231d36"
    }
  },
  "position": "bottom-left",
  "type": "opt-in"
});
</script>
